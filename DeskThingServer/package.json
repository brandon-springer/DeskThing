{
  "name": "deskthing",
  "version": "0.11.17",
  "description": "A DeskThing server to interface with the DeskThing car thing app",
  "main": "./out-headless/index.mjs",
  "author": "Riprod",
  "type": "module",
  "homepage": "https://github.com/ItsRiprod/DeskThing",
  "scripts": {
    "build:server": "vite build --config vite.config.ts",
    "build:admin": "cd admin && npx vite build",
    "build": "npm run build:server && npm run build:admin",
    "start": "node out-headless/index.mjs",
    "dev": "npm run build && npm run start",
    "dev:admin": "cd admin && npx vite --port 5173",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false",
    "postinstall": "npm rebuild sharp",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itsriprod/DeskThing.git"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "auto-launch": "^5.0.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "flashthing": "^0.1.5",
    "semver": "^7.6.3",
    "sharp": "^0.34.2",
    "uuid": "^10.0.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@deskthing/types": "^0.11.18",
    "@eslint/js": "^9.21.0",
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^18.19.9",
    "@types/semver": "^7.5.8",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "prettier": "^3.2.4",
    "typedoc": "^0.27.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
