{
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }],
  "typedocOptions": {
    "entryPoints": [
      "src/main/**/*.ts",
      "test/**/*.ts"
    ],
    "entryPointStrategy": "expand",
    "out": "docs",
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeExternals": true,
    "includeVersion": true,
    "categorizeByGroup": true,
    "categoryOrder": ["Main", "Test", "*"]
  }
}
